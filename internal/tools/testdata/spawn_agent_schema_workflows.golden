{
  "description": "Spawn a child agent to execute a subtask concurrently. The child runs to completion and returns its findings as prose. Pass `workflow` to run the child as the root of a configured workflow (research, wf); its subtree is then governed by that workflow's pool and typed workers.",
  "parameters": {
    "properties": {
      "label": {
        "description": "Short human label shown in the agent tree (required).",
        "type": "string"
      },
      "model": {
        "description": "Optional model ID (defaults to the parent's model).",
        "type": "string"
      },
      "system_prompt": {
        "description": "Optional system prompt override; fully replaces the inherited one.",
        "type": "string"
      },
      "task": {
        "description": "The child agent's task prompt (required).",
        "type": "string"
      },
      "tools": {
        "description": "Optional subset of parent tools to give the child. IMPORTANT: a non-empty subset that omits the blackboard_* tools WITHHOLDS shared-memory access from the child — it then cannot read or write the shared blackboard. If you are spawning children to collaborate through the blackboard (debate, ensemble, producer/consumer), either omit this field (the child inherits all tools) or include the blackboard_* tools you need (e.g. blackboard_write, blackboard_read, blackboard_keys) in the subset.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "workflow": {
        "description": "Optional workflow the child becomes the root of: research, wf. Its pool limits and typed workers then govern the child's subtree. Not allowed inside a workflow.",
        "enum": [
          "research",
          "wf"
        ],
        "type": "string"
      }
    },
    "required": [
      "label",
      "task"
    ],
    "type": "object"
  }
}
