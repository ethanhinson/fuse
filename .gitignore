.codeindex/

# built binary (make build)
/fuse

# cross-compiled build artifacts (make egress-forwarder). These are BUILT, never
# committed: an executable fuse bind-mounts into a sandbox and runs as the
# command's parent process must be reproducible from the source in this repo,
# not trusted because it happens to be sitting in the tree.
/dist/

# macOS finder cruft
.DS_Store

# npm workspaces: never commit installed deps or the TS SDK build output
node_modules/
sdk/ts/dist/

# local scratch + generated review artifacts (screenshots, videos, ad-hoc reports)
scratchpad/
reports/screenshots/
reports/*.md
ANALYSIS.md

# trusted-local operator config (.fuse/sandbox.local.yml is the sandbox
# off-switch). Machine- and trust-scoped: authorizing uncontained execution is a
# property of one operator's machine, never of the project, so it must never be
# committed or travel with a clone.
.fuse/

